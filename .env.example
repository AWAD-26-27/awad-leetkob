# Optional names only; no values or secrets.
# src/server.js: unset PORT uses 3007; an empty PORT requests port 0.
PORT=
# playwright.config.js: unset/empty uses Playwright's installed Chromium.
CHROME_PATH=
# Provisioned server-side for manual setup verification/future PA#3 only.
# npm start and CI do not consume these. Never put real values here.
GEMINI_API_KEY=
GEMINI_MODEL=
