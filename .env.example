# Local example. Keep real credentials in an ignored environment file.
# src/server.js: unset PORT uses 3007; an empty PORT requests port 0.
PORT=
# playwright.config.js: unset/empty uses Playwright's installed Chromium.
CHROME_PATH=
# PA3 worker and authorized checker runs. The web app and CI do not use the key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Use free for a verified free-tier project. Leave empty if billing is unknown.
GEMINI_BILLING_TIER=
# For the sort-merge lab with 80 Accepted submissions and one semantic constraint.
MAX_MODEL_CALLS_PER_LAB=80
